rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.createdAt is number;
    }

    function isValidChat(data) {
      return data.userId == request.auth.uid
        && data.title is string
        && data.createdAt is number
        && data.mode in ['chat', 'agent', 'game', 'app'];
    }

    function isValidMessage(data) {
      return data.userId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.timestamp is number
        && data.chatId is string;
    }

    // Phase 4: Production Rules
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }

    match /chats/{chatId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidChat(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidChat(incoming());

      match /messages/{messageId} {
        allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidMessage(incoming());
        allow update, delete: if false;
      }
    }
  }
}
